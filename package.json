{
  "name": "ger-morph-pw-gen",
  "version": "1.0.0",
  "description": "Memorable, keyboard-layout-safe German passphrases (e.g. flinkerFuchs.malt.leise.roteTomate.42!) with exact strength estimates",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "jest"
  },
  "keywords": [
    "password",
    "passphrase",
    "generator",
    "german",
    "morphology",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KGT1/ger-morph-pw-gen.git"
  }
}
